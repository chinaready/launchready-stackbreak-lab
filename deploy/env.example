# Maintainer host environment (optional)
# Copy to /opt/launchready-stackbreak-lab/.env on the production host — never commit .env.
# The weekly evidence workflow sources this file for Firebase + Netlify + Vercel + provenance metadata.

# Evidence provenance (also set CLOUD_REGION as a GitHub Actions variable)
CLOUD_PROVIDER="Alibaba Cloud"
CLOUD_REGION=cn-beijing-h
RUNNER_HOST=launchready.cn
PUBLIC_BASE_URL=https://stackbreak.launchready.cn
DEPLOY_PATH=/opt/launchready-stackbreak-lab

# Docker Hub mirror on mainland host (Docker Hub is blocked there)
NGINX_IMAGE=harbor.aicproxy.cn/dockerhub/library/nginx:alpine

# --- Netlify whole-stack probe (or set NETLIFY_* in GitHub Actions instead) ---
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_SITE_URL=

# --- Vercel whole-stack probe (or set VERCEL_* in GitHub Actions instead) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_SITE_URL=
BLOB_REGION="Hong Kong"
REDIS_REGION="Singapore"
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional aliases (same values; also accepted by probe scripts):
KV_REST_API_URL=
KV_REST_API_TOKEN=
pub_STORE_ID=
pub_READ_WRITE_TOKEN=

# --- Firebase whole-stack probe (required for weekly firebase-latest.json refresh) ---
# Web config: Firebase console -> Project settings -> General -> Your apps -> Web
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_FUNCTIONS_REGION=us-central1
FIREBASE_DB_URL=

# Service account JSON path on the host (gitignored file — see firebase-demo/setup/provision.md)
GOOGLE_APPLICATION_CREDENTIALS=/opt/launchready-stackbreak-lab/firebase-demo/service-account.json

# Demo user for authenticated frontend-path probes (password may instead be a GitHub secret)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Optional: FCM send probe token (any string proves backend reachability)
FCM_TEST_TOKEN=
