{
  "name": "launchready-stackbreak-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Open lab measuring which foreign web-stack dependencies break first in mainland China.",
  "license": "Apache-2.0",
  "homepage": "https://stackbreak.launchready.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/chinaready/launchready-stackbreak-lab.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report",
    "probe": "./probe/china-dependency-probe.sh",
    "validate:targets": "node scripts/validate-targets.mjs",
    "history:update": "node scripts/update-history.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "serve": "docker compose up --build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
