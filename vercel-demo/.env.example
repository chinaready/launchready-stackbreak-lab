# Vercel China demo — environment template.
# Copy to ../.env (repo-root .env is gitignored) and fill in your values.
# Quote any value containing spaces — run-all.sh sources this file.

# --- Vercel account + project (Account Settings -> Tokens) ---
# The token is a SECRET: it grants API access to your Vercel account. Keep it out of git.
VERCEL_TOKEN=your_personal_access_token

# Filled in after vercel link / first deploy (setup/provision.md prints both):
# Use team_... and prj_... IDs from Project Settings -> General (not the slug/name).
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxx
VERCEL_SITE_URL=https://stackbreak-vercel.vercel.app

# --- Vercel Storage ---
# Public Blob store (recommended for this demo — frontend probe writes via /api/stamp-report):
BLOB_STORE_ID=store_xxxxxxxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Legacy alias (optional; storage-env.mjs also reads pub_*):
# pub_STORE_ID=store_xxxxxxxx
# pub_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Upstash Redis (Marketplace integration):
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx
# Aliases (optional; same values as above):
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxx

# --- Storage region metadata (written into probe results) ---
BLOB_REGION="Hong Kong"
REDIS_REGION="Singapore"

# --- Verdict thresholds (seconds) ---
SLOW_THRESHOLD=5
CONNECT_TIMEOUT=10
MAX_TIME=30

# --- Evidence environment metadata (provenance, written into results) ---
CLOUD_PROVIDER="Alibaba Cloud"
CLOUD_REGION=cn-beijing-h
RUNNER_HOST=launchready.cn
