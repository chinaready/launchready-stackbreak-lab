//
// Field-reports demo security rules.
// Reports are readable by any signed-in user (incl. anonymous, matching the
// mainland frontend probe) and writable only by their author. Probe docs under
// /probes are open to authenticated reads so the frontend path can verify them.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorUid == request.auth.uid;
    }

    match /probes/{probeId} {
      allow read: if request.auth != null;
      allow write: if false; // server (Admin SDK) only
    }
  }
}
