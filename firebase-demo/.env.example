# Firebase China demo — environment template.
# Copy to .env (gitignored at repo root) and fill from your Firebase project.
# Web config values are public-safe; the service account JSON is a secret — keep it gitignored.

# --- Firebase web app config (Project settings -> General -> Your apps -> Web) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef

# --- Cloud Functions region (where helloProbe/stampReport are deployed) ---
FIREBASE_FUNCTIONS_REGION=us-central1

# --- Realtime Database URL (optional; transport probe only) ---
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com

# --- Backend path: service account JSON for firebase-admin (Project settings -> Service accounts) ---
# Absolute path on the ECS. Keep the file out of git.
GOOGLE_APPLICATION_CREDENTIALS=/opt/launchready-stackbreak-lab/firebase-demo/service-account.json

# --- Demo user used to mint a real ID token for authenticated frontend-path probes ---
DEMO_USER_EMAIL=demo-cn@example.com
DEMO_USER_PASSWORD=change-me-strong-password

# --- FCM: a device registration token to exercise the server send API (optional).
# Any string proves backend->FCM reachability; an invalid token returns a real API error,
# which still demonstrates the network path. Leave blank to skip the send call.
FCM_TEST_TOKEN=

# --- Verdict thresholds (seconds) ---
SLOW_THRESHOLD=5
CONNECT_TIMEOUT=10
MAX_TIME=30

# --- Evidence environment metadata (provenance, written into results) ---
CLOUD_PROVIDER=Alibaba Cloud
CLOUD_REGION=cn-beijing-h
RUNNER_HOST=launchready.cn
