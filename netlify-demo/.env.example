#
# Netlify China demo — environment template.
# Copy to ../.env (repo-root .env is gitignored) and fill in your values.
# Quote any value containing spaces — run-all.sh sources this file.

# --- Netlify account + site (User settings -> Applications -> Personal access tokens) ---
# The token is a SECRET: it grants API access to your Netlify account. Keep it out of git.
NETLIFY_AUTH_TOKEN=nfp_your_personal_access_token

# Filled in after the first deploy (netlify-demo/setup/provision.md prints both):
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000
NETLIFY_SITE_URL=https://stackbreak-netlify.netlify.app

# --- Identity (GoTrue) demo user, used by the backend probe to exercise sign-in ---
# Optional. Leave blank to probe Identity reachability without a live login.
DEMO_USER_EMAIL=hello@chinaready.co
DEMO_USER_PASSWORD=change-me-strong-password

# --- Verdict thresholds (seconds) ---
SLOW_THRESHOLD=5
CONNECT_TIMEOUT=10
MAX_TIME=30

# --- Evidence environment metadata (provenance, written into results) ---
CLOUD_PROVIDER="Alibaba Cloud"
CLOUD_REGION=cn-beijing-h
RUNNER_HOST=launchready.cn
