# Stack Break Lab — environment template.
# Copy to .env (gitignored) and fill what you have. Every value is OPTIONAL for a local build.
# Blank vendor keys fall back to public test keys or render the service's own "no key" state.

# --- GitHub (Step C: server + repo wiring) ---
GITHUB_ORG=chinaready
GITHUB_REPO=launchready-stackbreak-lab
# Only needed if you want me to create/push the repo for you. Leave blank if you create it yourself.
GITHUB_TOKEN=__ghp_xxx_or_leave_blank__

# --- launchready.cn Docker host (Step C: deploy) ---
SSH_HOST=__deploy host or IP__
SSH_USER=__deploy user__
SSH_PORT=22
DEPLOY_PATH=/opt/launchready-stackbreak-lab
PUBLIC_BASE_URL=https://stackbreak.launchready.cn

# --- Evidence environment metadata (written into results/latest.json for provenance) ---
CLOUD_PROVIDER=Alibaba Cloud
CLOUD_REGION=__e.g. cn-hangzhou__
RUNNER_HOST=launchready.cn

# --- Optional vendor TEST keys (demos work without them) ---
# reCAPTCHA: blank uses Google's public v2 test site key.
RECAPTCHA_TEST_SITE_KEY=
# Google Maps: blank shows the Maps "no API key" error state (still useful China evidence).
GMAPS_TEST_API_KEY=
# Google Tag Manager: e.g. GTM-XXXXXXX. Blank uses a placeholder container id.
GTM_TEST_CONTAINER_ID=
# Google Analytics 4: e.g. G-XXXXXXXXXX. Blank uses a placeholder measurement id.
GA4_TEST_MEASUREMENT_ID=
# Auth0 sandbox tenant for the Auth0 demo.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Adobe Fonts (Typekit) kit id, e.g. abc1def. Blank uses a placeholder kit.
TYPEKIT_KIT_ID=
