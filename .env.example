# Stack Break Lab — optional environment variables for local runs.
# Copyright (c) 2026 Chinaready. SPDX-License-Identifier: Apache-2.0
# Copy to .env (gitignored). Every value is optional for a local build.
# See firebase-demo/.env.example and netlify-demo/.env.example for whole-stack kits.

# --- Evidence metadata (written into probe output when you run from your machine) ---
CLOUD_PROVIDER=local
CLOUD_REGION=local
RUNNER_HOST=localhost
PUBLIC_BASE_URL=http://localhost:8080

# --- Optional vendor TEST keys (demos work without them) ---
# reCAPTCHA: blank uses Google's public v2 test site key.
RECAPTCHA_TEST_SITE_KEY=
# Google Maps: blank or placeholder shows the Maps "no API key" error state.
GMAPS_TEST_API_KEY=
# Google Tag Manager: e.g. GTM-XXXXXXX
GTM_TEST_CONTAINER_ID=
# Google Analytics 4: e.g. G-XXXXXXXXXX
GA4_TEST_MEASUREMENT_ID=
# Auth0 sandbox tenant for the Auth0 demo.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Adobe Fonts (Typekit) kit id, e.g. abc1def
TYPEKIT_KIT_ID=

# --- Playwright (optional) ---
# PLAYWRIGHT_BASE_URL=http://localhost:8080
